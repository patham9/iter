;; reasoning.metta: NAL inference over space.metta (transitive closure, symmetry/substitution, relational (x) symmetry). Invoked by transformations/reasoning.py; output parsed into inferred.metta.
(= (r6 $x) (/ (round-math (* $x 1000000)) 1000000.0))
(= (w $c) (if (< $c 1.0) (/ $c (- 1 $c)) 10000000000.0))
(= (ded $f1 $c1 $f2 $c2) (let $f (* $f1 $f2) ((r6 $f) (r6 (* (* $f $c1) $c2)))))
(= (rev ($f1 $c1) ($f2 $c2))
   (let* (($w1 (w $c1)) ($w2 (w $c2)) ($t (+ $w1 $w2)))
     (if (== $t 0) ($f1 $c1)
       ((r6 (/ (+ (* $w1 $f1) (* $w2 $f2)) $t)) (r6 (/ $t (+ $t 1)))))))
(= (cedge $a $b) (match &self (E $a $b $f $c) ($f $c)))
(= (cedge $a $b) (match &self (D $a $b $f $c) ($f $c)))
(= (isbase $a $b) (case (collapse (match &self (E $a $b $_f $_c) x)) ((() False) ($_ True))))
(= (isused $a $d $m) (case (collapse (match &self (U $a $d $m) x)) ((() False) ($_ True))))
(= (put $H $a $d $tv)
   (case (collapse (match &self ($H $a $d $f $c) ($f $c)))
     ((() (let ($nf $nc) $tv (add-atom &self ($H $a $d $nf $nc))))
      ((($f $c)) (let ($nf $nc) (rev ($f $c) $tv)
          (let $_ (remove-atom &self ($H $a $d $f $c)) (add-atom &self ($H $a $d $nf $nc))))))))
(= (init)
   (collapse (match &self ((--> $a $b) (stv $f $c))
     (if (isrel $a) (empty)
         (put E $a $b ($f $c))))))
(= (cands) (collapse
   (let* ((($a $m) (match &self (E $a $m $_x $_y) ($a $m))) ) ($a $m))))
(= (allc) (collapse
   (let* (($p (cedge $a $m)) ($q (cedge $m $d)))
     (if (or (isbase $a $d) (isused $a $d $m)) (empty)
       (let ($f1 $c1) $p (let ($f2 $c2) $q ($a $d $m (ded $f1 $c1 $f2 $c2))))))))
(= (apply $l) (if (== $l ()) ()
   (let ($a $d $m $tv) (car-atom $l)
     (if (isused $a $d $m) (apply (cdr-atom $l))
       (let* (($_1 (add-atom &self (U $a $d $m))) ($_2 (put N $a $d $tv))) (apply (cdr-atom $l)))))))
(= (merge) (collapse (match &self (N $a $d $f $c)
   (let $_ (remove-atom &self (N $a $d $f $c)) (put D $a $d ($f $c))))))
(= (loop $i) (if (>= $i 20) $i
   (let $cs (allc) (if (== $cs ()) $i (let* (($_ (apply $cs)) ($_m (merge))) (loop (+ $i 1)))))))
(= (run) (let* (($_ (init)) ($n (loop 0))) ($n (collapse (match &self (D $a $d $f $c) ($a $d $f $c))))))
(= (spair) (match &self (E $a $b $f $c) (superpose (($a $b $f $c) ($b $a $f $c)))))
(= (sc1) (let ($X $Y $sf $sc) (spair) (if (== $X $Y) (empty)
   (match &self (E $X $b $f $c) (if (or (== $b $Y) (isbase $Y $b)) (empty) ($Y $b (ded $sf $sc $f $c)))))))
(= (sc2) (let ($X $Y $sf $sc) (spair) (if (== $X $Y) (empty)
   (match &self (E $a $X $f $c) (if (or (== $a $Y) (isbase $a $Y)) (empty) ($a $Y (ded $sf $sc $f $c)))))))
(= (sapply $l) (if (== $l ()) ()
   (let ($a $d $tv) (car-atom $l) (let $_ (put S $a $d $tv) (sapply (cdr-atom $l))))))
(= (smerge) (collapse (match &self (S $a $d $f $c) (put D $a $d ($f $c)))))
(= (run2) (let* (($_ (init)) ($s1 (collapse (sc1))) ($s2 (collapse (sc2)))
   ($_a (sapply $s1)) ($_b (sapply $s2)) ($n (loop 0)) ($_m (smerge)))
   ($n (collapse (match &self (D $a $d $f $c) ($a $d $f $c))))))
(= (isrel $a) (if (== (get-metatype $a) Expression) (== (car-atom $a) ×) False))
(= (rinit) (collapse (match &self ((--> (× $x $y) $r) (stv $f $c)) (put R ($x $y) $r ($f $c)))))
(= (isR $k $r) (case (collapse (match &self (R $k $r $_f $_c) x)) ((() False) ($_ True))))
(= (rs1) (let ($X $Y $sf $sc) (spair) (if (== $X $Y) (empty)
   (match &self (R ($X $b) $r $f $c) (if (or (== $b $Y) (isR ($Y $b) $r)) (empty) (($Y $b) $r (ded $sf $sc $f $c)))))))
(= (rs2) (let ($X $Y $sf $sc) (spair) (if (== $X $Y) (empty)
   (match &self (R ($a $X) $r $f $c) (if (or (== $a $Y) (isR ($a $Y) $r)) (empty) (($a $Y) $r (ded $sf $sc $f $c)))))))
(= (rsapply $l) (if (== $l ()) ()
   (let ($k $r $tv) (car-atom $l) (let $_ (put RS $k $r $tv) (rsapply (cdr-atom $l))))))
(= (run3) (let* (($_r (rinit)) ($res (run2)) ($t1 (collapse (rs1))) ($t2 (collapse (rs2)))
   ($_a (rsapply $t1)) ($_b (rsapply $t2)))
   ($res (collapse (match &self (RS ($x $y) $r $f $c) ($x $y $r $f $c))))))
!(import! &self space)
!(run3)
